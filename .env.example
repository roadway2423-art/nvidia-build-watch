# 복사해서 사용: Copy-Item .env.example .env  (실제 토큰은 절대 커밋 금지, .env는 .gitignore 처리됨)

# --- 필수 (Telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

